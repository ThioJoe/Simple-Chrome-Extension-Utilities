{
  "manifest_version": 3,
  "name": "Userscript Manager",
  "version": "1.4",
  "description": "A simple manager to run custom JavaScript on websites.",
  "permissions": ["storage", "scripting", "activeTab", "userScripts", "webNavigation"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  }
}